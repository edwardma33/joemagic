# Public Supabase API credentials from Project Settings → API / Connect.
# These are safe to expose to the browser only because the products table uses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only credentials for /admin. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy key name is also supported: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_or_sk_live_key
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
